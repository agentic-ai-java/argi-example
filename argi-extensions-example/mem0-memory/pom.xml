<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.agentic-ai-java.examples</groupId>
    <artifactId>argi-extensions-example</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>example-mem0-memory</artifactId>
  <name>ARGI Example: mem0-memory</name>
  <description>Writes semantic memories to Mem0 and retrieves them with an explicit user scope.</description>
  <properties>
    <example.mainClass>io.github.agentic.ai.examples.Mem0MemoryExample</example.mainClass>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.agentic-ai-java</groupId>
      <artifactId>argi-starter-model-chat-memory-mem0</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>io.github.agentic.ai.examples.Mem0MemoryExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
