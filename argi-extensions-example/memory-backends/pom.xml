<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.agentic-ai-java.examples</groupId>
    <artifactId>argi-extensions-example</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>example-memory-backends</artifactId>
  <name>ARGI Example: memory-backends</name>
  <description>Profile-selected Redis, MongoDB, Elasticsearch, TableStore, Memcached, and JDBC chat repositories.</description>
  <properties>
    <example.mainClass>io.github.agentic.ai.examples.MemoryBackends</example.mainClass>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>io.github.agentic.ai.examples.MemoryBackends</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>memory-redis</id>
      <dependencies>
        <dependency>
          <groupId>io.github.agentic-ai-java</groupId>
          <artifactId>argi-starter-model-chat-memory-repository-redis</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>memory-mongodb</id>
      <dependencies>
        <dependency>
          <groupId>io.github.agentic-ai-java</groupId>
          <artifactId>argi-starter-model-chat-memory-repository-mongodb</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>memory-elasticsearch</id>
      <dependencies>
        <dependency>
          <groupId>io.github.agentic-ai-java</groupId>
          <artifactId>argi-starter-model-chat-memory-repository-elasticsearch</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>memory-tablestore</id>
      <dependencies>
        <dependency>
          <groupId>io.github.agentic-ai-java</groupId>
          <artifactId>argi-starter-model-chat-memory-repository-tablestore</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>memory-memcached</id>
      <dependencies>
        <dependency>
          <groupId>io.github.agentic-ai-java</groupId>
          <artifactId>argi-starter-model-chat-memory-repository-memcached</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>memory-mysql</id>
      <dependencies>
        <dependency>
          <groupId>io.github.agentic-ai-java</groupId>
          <artifactId>argi-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
          <groupId>com.mysql</groupId>
          <artifactId>mysql-connector-j</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>memory-postgresql</id>
      <dependencies>
        <dependency>
          <groupId>io.github.agentic-ai-java</groupId>
          <artifactId>argi-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
