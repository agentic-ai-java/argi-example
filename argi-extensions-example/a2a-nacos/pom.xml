<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.agentic-ai-java.examples</groupId>
    <artifactId>argi-extensions-example</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>example-a2a-nacos</artifactId>
  <name>ARGI Example: a2a-nacos</name>
  <description>Resolves an A2A agent by registered name in Nacos before delegation.</description>
  <properties>
    <example.mainClass>io.github.agentic.ai.examples.NacosA2aExample</example.mainClass>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.agentic-ai-java</groupId>
      <artifactId>argi-starter-a2a-nacos</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.agentic-ai-java</groupId>
      <artifactId>argi-agent-framework</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>io.github.agentic.ai.examples.NacosA2aExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
